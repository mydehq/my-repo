#!/usr/bin/env bash

set -e

# ------------- Configuration ---------------

REPO_NAME="{repo_name}"
REPO_DISPLAY_NAME="{repo_display_name}"
REPO_URL="{repo_url}"
REPO_DWN_URL="{repo_downd_suffix}"
PROJECT_URL="{project_url}"

# --------------- Helpers -----------------

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log() { echo -e "${BLUE}i $* ${NC}" >&2; }
log.ok() { echo -e "${GREEN}+ $* ${NC}" >&2; }
log.warn() { echo -e "${YELLOW}! $* ${NC}" >&2; }
log.err() { echo -e "${RED}x $* ${NC}" >&2; }

# Check if commands are available
has-cmd() {
    local cmd_str cmd_bin
    local missing_cmds=()

    [[ "$#" -eq 0 ]] && return 2

    for cmd_str in "$@"; do
        cmd_bin="${cmd_str%% *}"
        if ! command -v "$cmd_bin" &>/dev/null; then
            missing_cmds+=("$cmd_bin")
        fi
    done

    if [[ "${#missing_cmds[@]}" -gt 0 ]]; then
        echo "${missing_cmds[*]}"
        return 1
    fi
    return 0
}

# Removes a custom repository entry from /etc/pacman.conf safely
remove_repo() {
    local target_repo="$1"

    if [[ -z "$target_repo" ]]; then
        log.err "No repository name provided."
        return 1
    fi

    if ! grep -q "^\[${target_repo}\]" /etc/pacman.conf; then
        log.err "Repository [${target_repo}] not found in /etc/pacman.conf."
        return 0
    fi

    log "Removing [${target_repo}] from /etc/pacman.conf..."

    sudo -v

    # Delete block starting with [target_repo] up to the next [section] header or EOF
    sudo sed -i -e "/^\[${target_repo}\]/,/^\[/ { /^\[${target_repo}\]/d; /^\[/!d; }" /etc/pacman.conf

    return 0
}

print_help() {
    echo
    [[ "$1" != "-nh" ]] && echo -e "${BLUE}$REPO_DISPLAY_NAME Installer${NC}\n"
    echo -e "${GREEN}Usage${NC}: $0 [-u, --uninstall] [-h, --help]"
}


# --------------- Execution -----------------

case "$1" in
    "")
        # Default behavior: run installation
        ;;
    -u|--uninstall)
        uninstall=true
        ;;
    -h|--help)
        print_help
        exit 0
        ;;
    *)
        echo -e "\n${RED}Invalid option: $1${NC}"
        print_help -nh
        exit 1
        ;;
esac


# shellcheck disable=SC2050
if [[ "$REPO_NAME" == *repo_name* ]]; then
    echo
    log.err "You are running an uncompiled installer.\n"
    log "Please contact repo owner: $REPO_URL"
    exit 1
fi

# Handle uninstallation
if [[ "$uninstall" == "true" ]]; then
    read -rp "Are you sure you want to uninstall ${REPO_DISPLAY_NAME}? [y/N]: " REPLY

    if [[ ! "$REPLY" =~ ^[Yy]$ ]]; then
        log.ok "Uninstall cancelled."
        exit 0
    fi

    cat <<'EOF'
    _   _       _           _        _ _ _
   | | | |_ __ (_)_ __  ___| |_ __ _| | (_)_ __   __ _
   | | | | '_ \| | '_ \/ __| __/ _` | | | | '_ \ / _` |
   | |_| | | | | | | | \__ \ || (_| | | | | | | | (_| |_ _ _
    \___/|_| |_|_|_| |_|___/\__\__,_|_|_|_|_| |_|\__, (_|_|_)
                                                 |___/
EOF

    if remove_repo "$REPO_NAME"; then
        log.ok "Repository [$REPO_NAME] successfully removed."
        exit 0
    else
        log.err "Failed to remove repository [$REPO_NAME]."
        exit 1
    fi
fi


# Proceed with installation

cat <<'EOF'

    ___          _        _ _ _
   |_ _|_ __ ___| |_ __ _| | (_)_ __   __ _
   | || '_ \/ __| __/ _` | | | | '_ \ / _` |
   | || | | \__ \ || (_| | | | | | | | (_| | _ _ _
   |___|_| |_|___/\__\__,_|_|_|_|_||_|\__, /(_|_|_)
                                      |___/

EOF


# Check for required commands
log "Checking Prerequisites..."

if ! msing_cmds=$(has-cmd "sudo" "uname" "pacman" "curl" "grep" "sed"); then
    log.err "Missing required commands: ${msing_cmds}\n"
    exit 1
fi

# Check if running on Arch Linux
log "Checking System Requirements..."

[[ "$(uname -m)" != "x86_64" ]] && {
    log.err "This repository only supports x86_64 architecture."
    exit 1
}

[[ "$(uname -s)" != "Linux" ]] && {
    log.err "Unsupported OS: Only Linux (Arch Linux & its derivatives) are supported."
    exit 1
}

[[ ! -f /etc/os-release ]] && {
    log.err "Unknown Distro: /etc/os-release not found."
    exit 1
}

DISTRO_ID=$(source /etc/os-release && echo "${ID}:${ID_LIKE}")

if [[ "$DISTRO_ID" != *arch* ]]; then
    log.err "Unsupported Distro: Only Arch Linux (& its derivatives) are supported."
    exit 1
fi

# Check for existing repository
if grep -q "^\[$REPO_NAME\]" /etc/pacman.conf; then
    echo
    log.warn "Repository '${REPO_DISPLAY_NAME}' (${REPO_NAME}) is already installed!"

    read -rp "Do You Want to Re-Install? [y/N]: " CHOICE

    case "$CHOICE" in
        Y|y)
            log "Proceeding with re-installation..."
            remove_repo "${REPO_NAME}"
            ;;
        *)
            log "Aborted by user."
            exit 1
            ;;
    esac
fi


log "Adding $REPO_DISPLAY_NAME repo to /etc/pacman.conf..."

# Ask for sudo password up front
sudo -v -p "  Enter your sudo password: "

# Ensure file ends with a newline before appending
echo "" | sudo tee -a /etc/pacman.conf >/dev/null

cat <<-EOF | sudo tee -a /etc/pacman.conf >/dev/null

[${REPO_NAME}]
SigLevel = Optional TrustAll
Server = ${REPO_DWN_URL}
EOF

log.ok "Repository added."

echo; log "Syncing database..."

sudo pacman -Sy

echo
log.ok "Repository setup complete! Enjoy our packages!\n"
